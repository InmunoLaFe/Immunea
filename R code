library(dplyr)

resultats_adj <- list()

for(fam in names(families)){
  
  vars <- families[[fam]]
  
  res_fam <- lapply(vars, function(var){
    
    df2 <- df[, c(var, "grupo", "age", "sex")]
    df2 <- df2[complete.cases(df2), ]
    
    if(length(unique(df2$grupo)) < 2) return(NULL)
    
    df2$grupo <- factor(df2$grupo)
    df2$sex   <- factor(df2$sex)
    
    y <- df2[[var]]
    
    # MODEL GLOBAL
    fit <- lm(y ~ grupo + age + sex, data = df2)
    p_global <- tryCatch(anova(fit)["grupo", "Pr(>F)"], error = function(e) NA_real_)
    
    # DESCRIPTIUS
    stats <- df2 %>%
      group_by(grupo) %>%
      summarise(mean = mean(y), sd = sd(y), .groups="drop")
    
    mean_0 <- stats$mean[stats$grupo==0]
    sd_0   <- stats$sd[stats$grupo==0]
    
    mean_1 <- stats$mean[stats$grupo==1]
    sd_1   <- stats$sd[stats$grupo==1]
    
    mean_2 <- stats$mean[stats$grupo==2]
    sd_2   <- stats$sd[stats$grupo==2]
    
    # 🔥 COMPARACIONS PAIRWISE (això NO falla)
    
    get_p <- function(g1, g2){
      
      sub <- df2[df2$grupo %in% c(g1,g2), ]
      
      if(length(unique(sub$grupo)) < 2) return(NA_real_)
      
      
y_sub <- sub[[var]]
fit2 <- lm(y_sub ~ grupo + age + sex, data = sub)

      
      coef_name <- grep("grupo", rownames(summary(fit2)$coefficients), value=TRUE)
      
      if(length(coef_name)==0) return(NA_real_)
      
      summary(fit2)$coefficients[coef_name[1], "Pr(>|t|)"]
    }
    
    p_0_1 <- get_p(0,1)
    p_0_2 <- get_p(0,2)
    p_1_2 <- get_p(1,2)
    
    data.frame(
      variable = var,
      familia = fam,
      
      mean_0 = mean_0, sd_0 = sd_0,
      mean_1 = mean_1, sd_1 = sd_1,
      mean_2 = mean_2, sd_2 = sd_2,
      
      p_global = p_global,
      p_0_1 = p_0_1,
      p_0_2 = p_0_2,
      p_1_2 = p_1_2
    )
  })
  
  res_fam <- res_fam[!sapply(res_fam, is.null)]
  
  if(length(res_fam) > 0){
    
    df_res <- bind_rows(res_fam)
    
    # AJUSTOS
    df_res$p_adj_global <- p.adjust(df_res$p_global, method = "BH")
    
    df_res$p_0_1_adj <- p.adjust(df_res$p_0_1, method = "BH")
    df_res$p_0_2_adj <- p.adjust(df_res$p_0_2, method = "BH")
    df_res$p_1_2_adj <- p.adjust(df_res$p_1_2, method = "BH")
    
    resultats_adj[[fam]] <- df_res
  }
}

