# FUNCIÓ PER A CHI QUADRAT
analisi_binaria <- function(var, data, family){
  
  tmp <- data[, c(var, "grupo")]
  tmp <- tmp[complete.cases(tmp), ]
  
  tabla <- table(tmp[[var]], tmp$grupo)
  if(nrow(tabla) < 2 | ncol(tabla) < 2) return(NULL)
  
  # test global
  p_global <- if(any(tabla < 5)){
    fisher.test(tabla)$p.value
  } else {
    chisq.test(tabla)$p.value
  }
  
  # percentatges
  prop <- prop.table(tabla, 2) * 100
  
  get <- function(r, c){
    if(r %in% rownames(prop) & c %in% colnames(prop)){
      as.numeric(prop[r, c])
    } else NA_real_
  }
  
  perc_0 <- get("1","0")
  perc_1 <- get("1","1")
  perc_2 <- get("1","2")
  
  # Ns
  n_0 <- if("0" %in% colnames(tabla)) sum(tabla[,"0"]) else NA
  n_1 <- if("1" %in% colnames(tabla)) sum(tabla[,"1"]) else NA
  n_2 <- if("2" %in% colnames(tabla)) sum(tabla[,"2"]) else NA
  
  # pairwise
  combs <- combn(colnames(tabla), 2)
  
  get_p <- function(g1, g2){
    if(!(g1 %in% colnames(tabla) & g2 %in% colnames(tabla))) return(NA_real_)
    
    t2 <- tabla[, c(g1, g2), drop = FALSE]
    
    if(any(t2 < 5)){
      fisher.test(t2)$p.value
    } else {
      chisq.test(t2)$p.value
    }
  }
  
  p_0_1 <- get_p("0","1")
  p_0_2 <- get_p("0","2")
  p_1_2 <- get_p("1","2")
  
  data.frame(
    variable = var,
    familia = family,
    
    perc_0 = round(perc_0,2),
    perc_1 = round(perc_1,2),
    perc_2 = round(perc_2,2),
    
    n_0 = n_0,
    n_1 = n_1,
    n_2 = n_2,
    
    p_global = p_global,
    
    p_0_1 = p_0_1,
    p_0_2 = p_0_2,
    p_1_2 = p_1_2
  )
}
