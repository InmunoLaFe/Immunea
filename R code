```{r}
library(dplyr)
library(effectsize)

resultats_adj <- list()

for(fam in names(families)){

  vars <- families[[fam]]

  res_fam <- lapply(vars, function(var){

    df2 <- df[, c(var, "grupo", "age", "sex")]
    df2 <- df2[complete.cases(df2), ]

    if(nrow(df2) < 5) return(NULL)

    df2$grupo <- factor(df2$grupo)
    df2$sex <- factor(df2$sex)
    
    y <- df2[[var]]

    # MODEL GLOBAL
    fit <- lm(y ~ grupo + age + sex , data = df2)

    p_global <- tryCatch(
      anova(fit)["grupo", "Pr(>F)"],
      error = function(e) NA_real_
    )

    # DESCRIPTIUS + IC95%

    stats <- df2 %>%
      group_by(grupo) %>%
      summarise(
        n = n(),
        mean = mean(y, na.rm = TRUE),
        sd = sd(y, na.rm = TRUE),
        se = sd / sqrt(n),
        ci_low = mean - qt(0.975, df = n - 1) * se,
        ci_high = mean + qt(0.975, df = n - 1) * se,
        .groups = "drop"
      )

    mean_0 <- stats$mean[stats$grupo == 0]
    ci0_low <- stats$ci_low[stats$grupo == 0]
    ci0_high <- stats$ci_high[stats$grupo == 0]

    mean_1 <- stats$mean[stats$grupo == 1]
    ci1_low <- stats$ci_low[stats$grupo == 1]
    ci1_high <- stats$ci_high[stats$grupo == 1]

    mean_2 <- stats$mean[stats$grupo == 2]
    ci2_low <- stats$ci_low[stats$grupo == 2]
    ci2_high <- stats$ci_high[stats$grupo == 2]

    # FUNCIÓ COMPARACIONS PAIRWISE

    get_comparison <- function(g1, g2){

      sub <- df2[df2$grupo %in% c(g1, g2), ]

      if(length(unique(sub$grupo)) < 2){
        return(rep(NA, 7))
      }

      sub$grupo <- droplevels(sub$grupo)

      y_sub <- sub[[var]]

      fit2 <- lm(
        y_sub ~ grupo + age + sex ,
        data = sub
      )

      coef_name <- grep(
        "^grupo",
        rownames(summary(fit2)$coefficients),
        value = TRUE
      )

      if(length(coef_name) == 0){
        return(rep(NA, 7))
      }

      coef_tab <- summary(fit2)$coefficients

      beta <- coef_tab[coef_name[1], "Estimate"]
      se_beta <- coef_tab[coef_name[1], "Std. Error"]

      tcrit <- qt(0.975, fit2$df.residual)

      beta_low <- beta - tcrit * se_beta
      beta_high <- beta + tcrit * se_beta

      pval <- coef_tab[coef_name[1], "Pr(>|t|)"]

      d_res <- tryCatch(
        effectsize::cohens_d(
          as.formula(paste(var, "~ grupo")),
          data = sub,
          ci = 0.95
        ),
        error = function(e) NULL
      )

      if(is.null(d_res)){

        d <- NA
        d_low <- NA
        d_high <- NA

      } else {

        d <- d_res$Cohens_d[1]
        d_low <- d_res$CI_low[1]
        d_high <- d_res$CI_high[1]

      }

      c(
        beta = beta,
        beta_low = beta_low,
        beta_high = beta_high,
        pval = pval,
        d = d,
        d_low = d_low,
        d_high = d_high
      )
    }

    comp_0_1 <- get_comparison(0,1)
    comp_0_2 <- get_comparison(0,2)
    comp_1_2 <- get_comparison(1,2)

    data.frame(

      variable = var,
      familia = fam,

      mean_0 = mean_0,
      ci0_low = ci0_low,
      ci0_high = ci0_high,

      mean_1 = mean_1,
      ci1_low = ci1_low,
      ci1_high = ci1_high,

      mean_2 = mean_2,
      ci2_low = ci2_low,
      ci2_high = ci2_high,

      p_global = p_global,

      beta_0_1 = comp_0_1["beta"],
      beta_0_1_low = comp_0_1["beta_low"],
      beta_0_1_high = comp_0_1["beta_high"],
      p_0_1 = comp_0_1["pval"],

      d_0_1 = comp_0_1["d"],
      d_0_1_low = comp_0_1["d_low"],
      d_0_1_high = comp_0_1["d_high"],

      beta_0_2 = comp_0_2["beta"],
      beta_0_2_low = comp_0_2["beta_low"],
      beta_0_2_high = comp_0_2["beta_high"],
      p_0_2 = comp_0_2["pval"],

      d_0_2 = comp_0_2["d"],
      d_0_2_low = comp_0_2["d_low"],
      d_0_2_high = comp_0_2["d_high"],

      beta_1_2 = comp_1_2["beta"],
      beta_1_2_low = comp_1_2["beta_low"],
      beta_1_2_high = comp_1_2["beta_high"],
      p_1_2 = comp_1_2["pval"],

      d_1_2 = comp_1_2["d"],
      d_1_2_low = comp_1_2["d_low"],
      d_1_2_high = comp_1_2["d_high"]

    )

  })

  res_fam <- res_fam[!sapply(res_fam, is.null)]

  if(length(res_fam) > 0){

    df_res <- bind_rows(res_fam)

    df_res$p_adj_global <- p.adjust(df_res$p_global, method = "BH")

    df_res$p_0_1_adj <- p.adjust(df_res$p_0_1, method = "BH")
    df_res$p_0_2_adj <- p.adjust(df_res$p_0_2, method = "BH")
    df_res$p_1_2_adj <- p.adjust(df_res$p_1_2, method = "BH")

    resultats_adj[[fam]] <- df_res
  }

}

