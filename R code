```{r}
library(dplyr)
library(FSA) #per a Dunn

analisi_func <- function(var, data, family){
  
  df <- data %>%
    select(grupo, all_of(var)) %>%
    filter(!is.na(.data[[var]]), !is.na(grupo))
  
  if(length(unique(df$grupo)) < 2) return(NULL)
  
 
#Kruskal-Wallis (sense formula string)
kw <- kruskal.test(df[[var]] ~ df$grupo)



  
  
  #Mitjanes per grup
  stats <- df %>%
    group_by(grupo) %>%
    summarise(
      mean = mean(.data[[var]]),
      sd = sd(.data[[var]]),
      n = n(),
      .groups = "drop"
    )
  
#Posthoc Dunn
dunn <- dunnTest(x = df[[var]], g = df$grupo, method = "bh")
  
  list(
    variable = var,
    familia = family,
    kruskal_p = kw$p.value,
    stats = stats,
    posthoc = dunn$res
  )
}
```

```{r}
resultats <- list()

for(fam in names(families)){
  vars <- families[[fam]]
  
  res <- lapply(vars, function(v){
    analisi_func(v, df, fam)
  })
  
  # eliminar NULLs
  res <- res[!sapply(res, is.null)]
  
  if(length(res) > 0){
    
    df_res <- do.call(rbind, lapply(res, function(x){
      
      # stats en format ample
      st <- x$stats
      
      mean_0 <- st$mean[st$grupo == 0]
      sd_0   <- st$sd[st$grupo == 0]
      
      mean_1 <- st$mean[st$grupo == 1]
      sd_1   <- st$sd[st$grupo == 1]
      
      mean_2 <- st$mean[st$grupo == 2]
      sd_2   <- st$sd[st$grupo == 2]
      
      # Dunn posthoc
      dunn <- x$posthoc
      
      p_01 <- dunn$P.adj[dunn$Comparison == "0 - 1"]
      p_02 <- dunn$P.adj[dunn$Comparison == "0 - 2"]
      p_12 <- dunn$P.adj[dunn$Comparison == "1 - 2"]
      
      data.frame(
        variable = x$variable,
        familia = x$familia,
        
        mean_0 = mean_0, sd_0 = sd_0,
        mean_1 = mean_1, sd_1 = sd_1,
        mean_2 = mean_2, sd_2 = sd_2,
        
        kruskal_p = x$kruskal_p,
        
        p_0_1 = p_01,
        p_0_2 = p_02,
        p_1_2 = p_12
      )
    }))
    
    # ajust BH sobre el p global
    df_res$p_adj_global <- p.adjust(df_res$kruskal_p, method = "BH")
    
    resultats[[fam]] <- df_res
  }
}

final <- bind_rows(resultats)
